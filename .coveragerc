[run]
source = backend
branch = True
omit =
    */migrations/*
    */tests/*
    **/__init__.py
    **/admin/**
    admin.py
    manage.py

[report]
show_missing = True
# CI fails below this; raise it as coverage grows
fail_under = 94
exclude_lines =
    pragma: no cover
    def __str__
    def __repr__
    if __name__ == .__main__.:
