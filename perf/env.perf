# Environment for the perf stack (perf/docker-compose.perf.yml). Used as
# `uv run --env-file perf/env.perf ...`; these values override backend/.env.
DJANGO_SETTINGS_MODULE=core.config.django.perf
DJANGO_SECRET_KEY=perf-not-a-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_NAME=prunplanner_perf
DATABASE_USER=perf
DATABASE_PASSWORD=perf
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
# empty: never configure the legacy database, even if backend/.env does
DATABASE_LEGACY_NAME=

CACHE_DEFAULT_LOCATION=redis://127.0.0.1:56379/0
CELERY_BROKER_URL=redis://127.0.0.1:56379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/1

# long enough that simulated users never need to refresh during a load test
REST_FRAMEWORK_ACCESS_TOKEN_LIFETIME=240

EMAIL_RESEND_API_KEY=perf
VECTOR_ACTIVE=false
